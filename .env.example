# ── Frontend (read at request time — no rebuild needed) ───────────────
# URLs the BROWSER uses to reach the APIs. These are resolved per request from
# the container's environment, so `docker compose up -d frontend` is enough to
# apply a change — no rebuild.
#
# NOTE: this file is read by `docker compose`. It does NOT reach a host
# `npm run dev`, which only reads frontend/.env.local.
#
# Behind a reverse proxy (the argus-halo demo's Caddy), point each service at a
# PATH PREFIX on the proxy's own origin:
#     ARGUS_CURATOR_URL=/api/curator
#     ARGUS_LENS_URL=/api/lens
# An EMPTY value means the origin root (`/scan/folder`). That works for at most
# ONE backend: the six services all expose `/health`, and curator+lens both
# expose `/folders` while curator+quarry both expose `/thumb`, so a shared root
# is ambiguous. Prefer prefixes when more than one service is proxied.
ARGUS_LENS_URL=http://localhost:8100
ARGUS_CURATOR_URL=http://localhost:8101
# argus-quarry provenance server (the /gallery page).
ARGUS_QUARRY_URL=http://localhost:8102
# argus-forge training bridge (the ExportPanel "forge training config" step).
ARGUS_FORGE_URL=http://localhost:8103
# argus-proof post-training evaluation (the /proof review view + run trigger).
ARGUS_PROOF_URL=http://localhost:8104
# argus-atlas georeferenced map bakes (the /atlas page).
ARGUS_ATLAS_URL=http://localhost:8105

# Curator SPA mode.
#   demo — read-only bundled sample scan; no curator backend required (public demo).
#   live — real scans/exports against ARGUS_CURATOR_URL. Use this when you
#          bring up the curator/full profile below. (`local` is a legacy alias.)
ARGUS_CURATOR_UI_MODE=demo

# Paths as seen INSIDE the curator container (the compose mounts DATASET_DIR/OUTPUT_DIR
# there). These are the defaults the folder picker and export panel start from.
# Compose supplies these two values; running the image outside compose without
# them leaves the folder picker blank.
ARGUS_CURATOR_SOURCE_PATH=/data/images
ARGUS_CURATOR_OUTPUT_PATH=/data/out

# The pre-#56 NEXT_PUBLIC_* names are still honoured as a fallback if you have
# an older .env, but they no longer need a rebuild to take effect. The one that
# is not a straight prefix swap: NEXT_PUBLIC_API_URL is now ARGUS_LENS_URL.

# Browsing the UI from ANOTHER machine (LAN)? Point the ARGUS_*_URLs above at
# this host's IP, and widen curator/forge/atlas CORS to that browser origin — their
# images only allow http://localhost:3000 by default (lens/quarry/proof allow
# any origin). Comma-separated; keep localhost for same-host browsing.
# CURATOR_CORS_ORIGINS=http://localhost:3000,http://192.168.1.39:3000
# FORGE_CORS_ORIGINS=http://localhost:3000,http://192.168.1.39:3000
# ATLAS_CORS_ORIGINS=http://localhost:3000,http://192.168.1.39:3000

# ── Image tags (published GHCR images) ────────────────────────────────
# compose.yaml runs the backends from ghcr.io/smk762/<svc>:${<SVC>_TAG}. The
# default `latest` is the dev convenience; PIN an exact released version for
# reproducible deploys (the argus-halo demo host pins these in user_data).
#   docker compose --profile full pull      # refresh to the current tag
# (frontend has no published image — it is always built from ./frontend.)
CURATOR_TAG=latest
LENS_TAG=latest
QUARRY_TAG=latest
FORGE_TAG=latest
PROOF_TAG=latest
ATLAS_TAG=latest

# ── Suite services (compose profiles) ─────────────────────────────────
# Host directories shared with the backends. Both curator and lens mount
# DATASET_DIR at /data/images so the curate -> caption handoff works.
# Use absolute paths (compose does NOT expand ~). Leave HF_CACHE_DIR unset to
# default to ${HOME}/.cache/huggingface.
DATASET_DIR=./data
OUTPUT_DIR=./out
# HF_CACHE_DIR=/home/you/.cache/huggingface

# argus-quarry (gallery profile) — upstream acquisition of PD/CC0 images,
# grouped into LoRA-training categories (identity/wardrobe/setting/concept).
# QUARRY_HOME is quarry's side-car pool + provenance DB (mounted at /data/quarry).
# It is also mounted read-only into curator/lens so quarry's published symlinks
# (which point back into the pool) resolve inside those containers. Use absolute
# paths. QUARRY_MAX_GB caps the total raw-pool size (0 = unlimited).
QUARRY_HOME=./quarry
QUARRY_MAX_GB=40
# Public-domain metadata archives for /gallery -> Sources: a directory holding
# pd12m/ and megalith/ as written by argus-quarry's
# scripts/fetch_public_domain_metadata.py (links, captions, sizes; ~45 GB with
# PD12M's CLIP embeddings, no photos). Mounted read-only into the quarry server;
# build its search index once with
#   docker compose run --rm argus-quarry-server archives index
# PUBLIC_DOMAIN_DIR=/media/photos/public_domain
# Let the Sources view land a slice in the pool itself (otherwise it hands back
# slice.json + `argus-quarry archives fetch slice.json`). Off by default.
# QUARRY_ALLOW_FETCH=1
# The fetch is a browser POST, which quarry never grants to its default "*"
# CORS, so also list every origin the studio is opened from (argus-quarry
# >= 0.3.1). This replaces "*" for the quarry server's reads too.
# QUARRY_CORS_ORIGINS=http://localhost:3000,http://192.168.1.39:3000
COMMONS_USER_AGENT=argus-quarry/0.2 (contact@example.com)

# Optional Immich integration (lens /immich/* endpoints: caption straight from
# an Immich album, or pull an album into DATASET_DIR for curation). Create an
# API key in Immich under Account Settings -> API Keys. Leave unset to disable.
# IMMICH_URL=http://immich:2283
# IMMICH_API_KEY=

# argus-proof (proof/full profiles) — post-training evaluation runs.
# The generation engine's model tree (ComfyUI layout: checkpoints/ + loras/),
# mounted read-only at /data/models so run manifests SHA256-pin the weights and
# GET /models can populate the /proof pickers. Absolute paths. If your ComfyUI
# also loads from an extra_model_paths tree, point MODELS_EXTRA_DIR at it.
MODELS_DIR=./models
# MODELS_EXTRA_DIR=/path/to/extra_models/models-hot
# Backend that generates the eval grid, and how the proof CONTAINER reaches it.
# host.docker.internal targets a ComfyUI on the compose host (port 8188).
PROOF_BACKEND=comfyui
COMFYUI_BASE_URL=http://host.docker.internal:8188
# pip extras baked into the proof image. Default is light (phash dedup/diversity
# only); "server,cli,score" adds identity/quality/safety scorers (torch stack).
# Only applies to a source build (-f compose.build.yaml); the published image
# ships with server,cli.
PROOF_EXTRAS=server,cli

# argus-atlas (atlas/full profiles) — bake a fantasy map from real terrain.
# DEM_DIR holds the DEMs (GeoTIFF or .vrt, e.g. Copernicus GLO-30) and vector
# layers the /atlas page can name; mounted at /data/dem. Jobs land under
# OUTPUT_DIR/atlas. Bakes go through COMFYUI_BASE_URL (above) using MODELS_DIR.
DEM_DIR=./dem
# Baking needs a GPU (ComfyUI) and is OFF unless set. ATLAS_ALLOW_OSM=1 lets
# the server fetch OSM layers from Overpass itself.
# ATLAS_ALLOW_BAKE=1
# ATLAS_ALLOW_OSM=1

# argus-lens
ARGUS_BACKEND=hybrid
ARGUS_API_KEY=
# WD14 tags locally + prose from an OpenAI-compatible server (Ollama, vLLM):
#   ARGUS_BACKEND=hybrid:wd14+openai-compat
# The URL is reached from INSIDE the lens container: use the LAN host's IP, or
# host.docker.internal for an Ollama on this machine.
# ARGUS_OPENAI_COMPAT_BASE_URL=http://192.168.1.50:11434/v1
# ARGUS_OPENAI_COMPAT_MODEL=qwen3-vl:8b
# ARGUS_OPENAI_COMPAT_API_KEY=
# Prompt preset (detailed, straightforward, descriptive, booru, count) or literal
# text. Default detailed; straightforward suits Qwen3-VL / JoyCaption for training.
# ARGUS_OPENAI_COMPAT_PROMPT=straightforward
# WD v3 tagger repo (default SmilingWolf/wd-vit-tagger-v3). WD14_CACHE_DIR is the
# host dir mounted as its cache (default ${HOME}/.cache/wd14_tagger).
# WD14_MODEL_REPO=SmilingWolf/wd-eva02-large-tagger-v3
# WD14_CACHE_DIR=/home/you/.cache/wd14_tagger
# Optional LLM rewrite of assembled captions, kept only when it passes lens's
# post-check. Leave ARGUS_REFINE_MODEL unset to disable.
# ARGUS_REFINE_MODEL=qwen3:8b
# ARGUS_REFINE_BASE_URL=http://192.168.1.50:11434/v1
# ARGUS_REFINE_API_KEY=
# ARGUS_REFINE_VARIANTS=training,training_prose
# Sharing the GPU with ComfyUI: release lens's VRAM after N idle seconds.
# ARGUS_IDLE_UNLOAD_S=120
# ARGUS_GPU_COORDINATOR=none
# pip extras baked into the standalone lens image. Default is a self-contained
# local backend; use "server,openai,replicate" for a light cloud-only image.
# Only applies to a source build (-f compose.build.yaml); the published image
# ships with server,local.
LENS_EXTRAS=server,local

# ── Ports (host side) ─────────────────────────────────────────────────
FRONTEND_PORT=3000
LENS_PORT=8100
CURATOR_PORT=8101
QUARRY_SERVER_PORT=8102
FORGE_PORT=8103
PROOF_PORT=8104
ATLAS_PORT=8105
